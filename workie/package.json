{
  "name": "@moreplease/workie",
  "version": "0.0.1",
  "description": "Generate GitHub Actions workflows for a Turbo monorepo",
  "keywords": [
    "github",
    "gha",
    "turbo",
    "turborepo",
    "monorepo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "0BSD",
  "author": "Iain Merrick <iain@moreplease.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/more-please/more-stuff.git",
    "directory": "workie"
  },
  "type": "module",
  "main": "./workie.ts",
  "exports": {
    ".": "./workie.ts",
    "./schemas/github-workflow.json": "./schemas/github-workflow.json"
  },
  "bin": {
    "workie": "workie-cli.ts"
  },
  "scripts": {
    "build-validator": "node schemas/build.mjs",
    "check": "tsc",
    "test": "vitest run --testTimeout 5000"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
